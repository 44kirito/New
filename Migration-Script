#!/usr/bin/env bash
set -euo pipefail

# Helper to reliably get terminal width
get_cols() {
  local cols=""
  cols=$(tput cols 2>/dev/null) || true
  if [[ -z "$cols" || "$cols" -le 0 ]]; then
    cols=$(stty size 2>/dev/null | awk '{print $2}') || true
  fi
  echo "${cols:-80}"
}

# --- Terminal Centering & Input Helpers ---
center() {
  local clean
  clean=$(echo -e "$1" | sed -r 's/\x1B\[[0-9;]*[mK]//g')
  local cols
  cols=$(get_cols)
  local pad=$(( (cols - ${#clean}) / 2 ))
  (( pad < 0 )) && pad=0
  printf "%*s%b\n" "$pad" "" "$1"
}

center_read() {
  local prompt="$1"
  local varname="${2:-REPLY}"
  local default_val="${3:-}"
  local color="${4:-}"
  local clean
  clean=$(echo -e "$prompt$default_val" | sed -r 's/\x1B\[[0-9;]*[mK]//g')
  local cols
  cols=$(get_cols)
  local pad=$(( (cols - ${#clean}) / 2 ))
  (( pad < 0 )) && pad=0
  local spaces
  printf -v spaces "%*s" "$pad" ""

  if [[ -n "$default_val" ]]; then
    if [[ -n "$color" ]]; then
      local esc_color
      printf -v esc_color "%b" "$color"
      read -e -p "${spaces}${prompt}"$'\001'"${esc_color}"$'\002' -i "$default_val" "$varname"
      printf "\033[0m"
    else
      read -e -p "${spaces}${prompt}" -i "$default_val" "$varname"
    fi
  else
    read -e -p "${spaces}${prompt}" "$varname"
  fi
}

# --- Centered Background Progress Bar (Compression) ---
show_progress() {
  local pid=$1
  local width=36
  local pos=0
  local dir=1
  local block=8

  tput civis 2>/dev/null || true

  while kill -0 "$pid" 2>/dev/null; do
    local bar=""
    for ((i=0; i<width; i++)); do
      if (( i >= pos && i < pos + block )); then
        bar+="#"
      else
        bar+="-"
      fi
    done

    local line="Compressing: [${bar}]"
    local cols
    cols=$(get_cols)
    local pad=$(( (cols - ${#line}) / 2 ))
    (( pad < 0 )) && pad=0

    printf "\r%*s\033[0;32m%s\033[0m" "$pad" "" "$line"

    pos=$((pos + dir))
    if (( pos + block >= width )); then
      dir=-1
    elif (( pos <= 0 )); then
      dir=1
    fi

    sleep 0.1
  done

  local full_bar
  printf -v full_bar "%*s" "$width" ""
  full_bar=${full_bar// /#}
  local done_line="Compressing: [${full_bar}] Done!"
  local cols
  cols=$(get_cols)
  local pad=$(( (cols - ${#done_line}) / 2 ))
  (( pad < 0 )) && pad=0
  printf "\r%*s\033[1;32m%s\033[0m\n" "$pad" "" "$done_line"

  tput cnorm 2>/dev/null || true
}

# --- Centered 0%-100% Progress Bar (Verification) ---
show_verify_progress() {
  local pid=$1
  local total_bytes=$2
  local width=36

  tput civis 2>/dev/null || true

  while kill -0 "$pid" 2>/dev/null; do
    local current_bytes=0
    if [[ -r "/proc/${pid}/fdinfo/0" ]]; then
      current_bytes=$(awk '/^pos:/ {print $2}' "/proc/${pid}/fdinfo/0" 2>/dev/null || echo 0)
    fi

    local pct=0
    if (( total_bytes > 0 )); then
      pct=$(( current_bytes * 100 / total_bytes ))
      (( pct > 99 )) && pct=99
      (( pct < 0 )) && pct=0
    fi

    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local bar_fill=""
    local bar_empty=""
    (( filled > 0 )) && printf -v bar_fill "%*s" "$filled" "" && bar_fill=${bar_fill// /#}
    (( empty > 0 )) && printf -v bar_empty "%*s" "$empty" "" && bar_empty=${bar_empty// /-}

    local line
    printf -v line "Verifying: [%s%s] %3d%%" "$bar_fill" "$bar_empty" "$pct"
    local cols
    cols=$(get_cols)
    local pad=$(( (cols - ${#line}) / 2 ))
    (( pad < 0 )) && pad=0

    printf "\r%*s\033[0;32m%s\033[0m" "$pad" "" "$line"
    sleep 0.1
  done

  local full_bar
  printf -v full_bar "%*s" "$width" ""
  full_bar=${full_bar// /#}
  local done_line="Verifying: [${full_bar}] 100%"
  local cols
  cols=$(get_cols)
  local pad=$(( (cols - ${#done_line}) / 2 ))
  (( pad < 0 )) && pad=0
  printf "\r%*s\033[1;32m%s\033[0m\n" "$pad" "" "$done_line"

  tput cnorm 2>/dev/null || true
}

# --- Root & Directory Checks ---
if [[ "$EUID" -ne 0 ]]; then
  echo ""
  center "\033[0;31mError: This script must be run as root (use sudo or log in as root).\033[0m"
  echo ""
  exit 1
fi

BASE_DIR="/home/consortium3"
if [[ ! -d "$BASE_DIR" ]]; then
  echo ""
  center "\033[0;31mError: Directory $BASE_DIR does not exist.\033[0m"
  echo ""
  exit 1
fi

TMP_DIR="${BASE_DIR}/TMP"
INFO_FILE="${TMP_DIR}/system_info.txt"

# Always clean up TMP directory and restore cursor on exit or failure
cleanup() {
  tput cnorm 2>/dev/null || true
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

# Start fresh TMP folder
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"

# --- Part 1: System Info ---
echo ""
center "\033[0;36m[Part 1] Gathering system information...\033[0m"
{
  echo "=========================================="
  echo "HOSTNAME"
  echo "=========================================="
  hostname
  echo ""

  echo "=========================================="
  echo "IP ADDRESS"
  echo "=========================================="
  ip addr | awk '
    /^[0-9]+:/ {
      iface = $2
      skip = (iface == "lo:")
      if (!skip) print iface
      next
    }
    !skip && /link\/ether/ {
      print "    " $2
      next
    }
    !skip && /^[[:space:]]*altname/ {
      print "    " $1 " " $2
      next
    }
    !skip && /^[[:space:]]*inet / {
      print "    " $2
      next
    }
  '
  echo ""

  echo "=========================================="
  echo "TIME ZONE"
  echo "=========================================="
  timedatectl | awk '/Time zone:/ {sub(/^[[:space:]]+/, ""); print}'
} > "$INFO_FILE"
center "\033[0;32m[OK] Created system_info.txt\033[0m"
echo ""

# Helper function to preserve exact ownership, permissions, and path hierarchy
copy_preserve() {
  local src="$1"
  if [[ -e "$src" ]]; then
    local parent_dest="${TMP_DIR}$(dirname "$src")"
    mkdir -p "$parent_dest"
    cp -a "$src" "$parent_dest/"
    center "\033[0;32m[OK] Copied ${src}\033[0m"
  else
    center "\033[0;33m[SKIP] Not found: ${src}\033[0m"
  fi
}

# --- Part 2: Directories ---
center "\033[0;36m[Part 2] Backing up directories (preserving ownership & permissions)...\033[0m"
copy_preserve "/usr/local/etc/kamailio"
copy_preserve "/usr/local/freeswitch/conf"
copy_preserve "/etc/sysconfig/network-scripts"
copy_preserve "/etc/httpd"
copy_preserve "/etc/pki/tls"
copy_preserve "/home/consortium3/.wine/drive_c/audiosrv/mvipsmal"
echo ""

# --- Part 3: Configuration Files ---
center "\033[0;36m[Part 3] Backing up configuration files (preserving ownership & permissions)...\033[0m"
copy_preserve "/etc/ntp.conf"
copy_preserve "/etc/rsyslog.conf"
copy_preserve "/etc/consortium3.conf"
echo ""

# --- Part 4: Audio Recordings (Optional) ---
center "\033[0;36m[Part 4] Handling audio recordings directory...\033[0m"
RECORDING_DIR="/home/consortium3/.wine/drive_c/audiosrv/recording"
INCLUDE_RECORDINGS="n"

if [[ -d "$RECORDING_DIR" ]]; then
  center_read "Include audio recordings in backup? (y/n): " INCLUDE_RECORDINGS "n" "\033[0;32m"
  if [[ "$INCLUDE_RECORDINGS" =~ ^[Yy]$ ]]; then
    copy_preserve "$RECORDING_DIR"
  else
    DEST_REC_DIR="${TMP_DIR}${RECORDING_DIR}"
    mkdir -p "$DEST_REC_DIR"
    chown --reference="$RECORDING_DIR" "$DEST_REC_DIR"
    chmod --reference="$RECORDING_DIR" "$DEST_REC_DIR"
    center "\033[0;33m[SKIP] Recordings excluded (empty folder & permissions preserved)\033[0m"
  fi
else
  center "\033[0;33m[SKIP] Not found: ${RECORDING_DIR}\033[0m"
fi
echo ""

# --- Part 5: Compress, Verify & Clean Up TMP ---
center "\033[0;36m[Part 5] Packaging and verifying backup archive...\033[0m"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
HOSTNAME_SHORT=$(hostname -s)
DEFAULT_ARCHIVE="${HOSTNAME_SHORT}-migration-backup-${TIMESTAMP}.tar.bz2"

center_read "Backup archive filename: " ARCHIVE_NAME "$DEFAULT_ARCHIVE" "\033[0;32m"
echo ""

# Ensure .tar.bz2 extension if user edited the name without one
[[ "$ARCHIVE_NAME" != *.tar.bz2 ]] && ARCHIVE_NAME="${ARCHIVE_NAME}.tar.bz2"
ARCHIVE_PATH="${BASE_DIR}/${ARCHIVE_NAME}"

# Overwrite protection if file already exists
if [[ -e "$ARCHIVE_PATH" ]]; then
  center "\033[1;33mWarning: ${ARCHIVE_PATH} already exists!\033[0m"
  center_read "Overwrite existing archive? (y/n): " OVERWRITE "n" "\033[0;32m"
  echo ""
  if [[ ! "$OVERWRITE" =~ ^[Yy]$ ]]; then
    center "\033[0;31mBackup cancelled.\033[0m"
    echo ""
    exit 1
  fi
fi

center "\033[0;36mCreating compressed archive (preserving ownership & permissions)...\033[0m"
echo ""

set +e
tar -cjpf "$ARCHIVE_PATH" \
  --numeric-owner \
  -C "$TMP_DIR" . 2>"${BASE_DIR}/tar_error.log" &
TAR_PID=$!

show_progress "$TAR_PID"
wait "$TAR_PID"
TAR_EXIT=$?
set -e

if [[ "$TAR_EXIT" -ne 0 ]]; then
  echo ""
  center "\033[0;31mERROR: Archive creation failed (tar exit code $TAR_EXIT):\033[0m"
  cat "${BASE_DIR}/tar_error.log" >&2
  rm -f "${BASE_DIR}/tar_error.log"
  echo ""
  exit 1
fi
rm -f "${BASE_DIR}/tar_error.log"

# Set ownership to consortium3 for WinSCP / PSFTP download
if id "consortium3" &>/dev/null; then
  chown consortium3:consortium3 "$ARCHIVE_PATH"
fi
chmod 600 "$ARCHIVE_PATH"

echo ""
center "\033[0;36mVerifying archive integrity...\033[0m"
echo ""

TOTAL_BYTES=$(stat -c%s "$ARCHIVE_PATH" 2>/dev/null || echo 0)

set +e
tar -tj < "$ARCHIVE_PATH" > /dev/null 2>&1 &
VERIFY_PID=$!

show_verify_progress "$VERIFY_PID" "$TOTAL_BYTES"
wait "$VERIFY_PID"
VERIFY_EXIT=$?
set -e

if [[ "$VERIFY_EXIT" -eq 0 ]]; then
  SIZE=$(du -sh "$ARCHIVE_PATH" | cut -f1)
  echo ""
  center "\033[1;32m==============================================================\033[0m"
  center "\033[1;32m               BACKUP COMPLETED & VERIFIED                    \033[0m"
  center "\033[1;32m==============================================================\033[0m"
  echo ""
  center "\033[1;33mArchive File : ${ARCHIVE_PATH}\033[0m"
  center "\033[1;33mArchive Size : ${SIZE}\033[0m"
  center "\033[1;33mRecordings   : $( [[ "$INCLUDE_RECORDINGS" =~ ^[Yy]$ ]] && echo "Included" || echo "Excluded (Folder Kept)" )\033[0m"
  echo ""
  center "Ready to download via WinSCP or PSFTP from ${BASE_DIR}/"
  echo ""
else
  echo ""
